def test_notification_uses_supplier_email(client, monkeypatch):
    """Low-stock notifications are sent to the supplier when available."""

    supplier_response = client.post("/suppliers", json={
        "name": "Meow Supplies",
        "contact_email": "supplier@example.com"
    })

    assert supplier_response.status_code == 201
    supplier_id = supplier_response.get_json()["id"]

    product_id = make_test_product(client)

    calls = []

    def fake_send_notification(recipient, subject, message):
        calls.append((recipient, subject, message))
        return True

    monkeypatch.setattr(
        "app.routes.transactions.notification_service.send_notification",
        fake_send_notification
    )

    response = client.post("/transactions", json={
        "product_id": product_id,
        "supplier_id": supplier_id,
        "type": "OUT",
        "quantity": 15
    })

    assert response.status_code == 201
    assert len(calls) == 1
    assert calls[0][0] == "supplier@example.com"
    
