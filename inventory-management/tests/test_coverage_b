# SUPPLIERS.PY TESTS
# =========================

def test_supplier_products_not_found(client):
    """A nonexistent supplier returns 404."""
    response = client.get("/suppliers/999/products")

    assert response.status_code == 404
    assert response.get_json() == {"error": "Supplier not found"}


def test_supplier_products_only_returns_received_products(client):
    """Only products with IN transactions from this supplier are returned."""
    supplier_id = make_supplier(client)
    product_id = make_product(client)

    in_response = client.post("/transactions", json={
        "product_id": product_id,
        "supplier_id": supplier_id,
        "type": "IN",
        "quantity": 10
    })

    out_response = client.post("/transactions", json={
        "product_id": product_id,
        "supplier_id": supplier_id,
        "type": "OUT",
        "quantity": 2
    })

    assert in_response.status_code == 201
    assert out_response.status_code == 201

    response = client.get(f"/suppliers/{supplier_id}/products")

    assert response.status_code == 200
    products = response.get_json()
    assert len(products) == 1
    assert products[0]["id"] == product_id
    assert products[0]["name"] == "Needoh"


def test_supplier_products_ignores_deleted_products(client):
    """An IN transaction referencing a missing product is safely ignored."""
    supplier_id = make_supplier(client)

    transaction = Transaction(
        id=store.next_id("transaction"),
        product_id=999,
        supplier_id=supplier_id,
        type="IN",
        quantity=10
    )
    store.transactions[transaction.id] = transaction

    response = client.get(f"/suppliers/{supplier_id}/products")

    assert response.status_code == 200
    assert response.get_json() == []


def test_update_supplier_details(client):
    """Updating a supplier changes its name and contact email."""
    supplier_id = make_supplier(client)

    response = client.put(f"/suppliers/{supplier_id}", json={
        "name": "Updated Supplier",
        "contact_email": "updated@example.com"
    })

    assert response.status_code == 200
    assert response.get_json()["name"] == "Updated Supplier"
    assert response.get_json()["contact_email"] == "updated@example.com"


