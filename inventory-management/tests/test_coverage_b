    }


def test_bestsellers_rejects_negative_days(client):
    """A negative reporting period returns an error."""
    response = client.get("/reports/bestsellers?days=-5")

    assert response.status_code == 400
    assert response.get_json() == {
        "error": "days must be greater than 0"
    }


def test_bestsellers_only_counts_recent_out_transactions(client):
    """Recent OUT transactions count; old OUT and recent IN transactions do not."""
    product_id = make_product(client)

    today = date.today()
    old_date = today - timedelta(days=40)

    recent_transaction = Transaction(
        id=store.next_id("transaction"),
        product_id=product_id,
        type="OUT",
        quantity=10,
        transaction_date=today
    )

    old_transaction = Transaction(
        id=store.next_id("transaction"),
        product_id=product_id,
        type="OUT",
        quantity=50,
        transaction_date=old_date
    )

    received_transaction = Transaction(
        id=store.next_id("transaction"),
        product_id=product_id,
        type="IN",
        quantity=100,
        transaction_date=today
    )

    store.transactions[recent_transaction.id] = recent_transaction
    store.transactions[old_transaction.id] = old_transaction
    store.transactions[received_transaction.id] = received_transaction

    response = client.get("/reports/bestsellers?days=30")

    assert response.status_code == 200

    results = response.get_json()
    assert len(results) == 1
    assert results[0]["product_id"] == product_id
    assert results[0]["units_sold"] == 10
    assert results[0]["sales_rate"] == 0.33


def test_bestsellers_ignores_missing_products(client):
    """Transactions for products that no longer exist are ignored."""
    transaction = Transaction(
        id=store.next_id("transaction"),
        product_id=999,
        type="OUT",
        quantity=10
    )
    store.transactions[transaction.id] = transaction

    response = client.get("/reports/bestsellers")

    assert response.status_code == 200
    assert response.get_json() == []


